# Next.js-only full-stack configuration
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_API_TIMEOUT=15000

# Direct MySQL connection used by Next.js API routes
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=plan_achievement
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_CONNECTION_LIMIT=10

# Auth
JWT_SECRET=change-this-secret-before-production
JWT_EXPIRES_IN=7d
